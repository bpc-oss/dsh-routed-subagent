{
  "name": "dsh-routed-subagent",
  "version": "0.1.0",
  "description": "Global DeepSeek Harness plugin: subagent_routed — run a one-shot subagent fully mounted on ANY agent preset, from ANY session, with per-call model/provider override and a model-availability pre-check.",
  "type": "module",
  "main": "lib/index.js",
  "private": true,
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "agent-preset",
    "subagent",
    "delegation",
    "multi-agent"
  ],
  "author": "bpc-oss",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "echo no-build: plain ESM plugin",
    "check": "node --check lib/index.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpc-oss/dsh-routed-subagent.git"
  },
  "homepage": "https://github.com/bpc-oss/dsh-routed-subagent",
  "bugs": {
    "url": "https://github.com/bpc-oss/dsh-routed-subagent/issues"
  },
  "files": [
    "lib/",
    "scripts/",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "cordis.patch.yml",
    ".gitignore"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
